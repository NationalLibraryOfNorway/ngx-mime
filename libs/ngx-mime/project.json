{
  "name": "ngx-mime",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/ngx-mime/src",
  "prefix": "nationallibraryofnorway",
  "tags": [],
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "{projectRoot}",
        "dist/libs/@nationallibraryofnorway/ngx-mime"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/libs/@nationallibraryofnorway/ngx-mime"
      ],
      "options": {
        "project": "libs/ngx-mime/ng-package.json",
        "tsConfig": "libs/ngx-mime/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ngx-mime/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "prepare-release": {
      "command": "if [ \"$NX_DRY_RUN\" != \"true\" ]; then git add -f dist/apps/elements dist/libs/@nationallibraryofnorway/ngx-mime; fi",
      "dependsOn": [
        {
          "projects": ["ngx-mime", "elements"],
          "target": "build",
          "params": "forward"
        }
      ],
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/libs/@nationallibraryofnorway/ngx-mime",
        "access": "public"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/ngx-mime/jest.config.ts",
        "tsConfig": "libs/ngx-mime/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
